# --- KerveinBlog / 阿里云 DirectMail SMTP ---
# Discourse 仅使用阿里云 SMTP 发信；不启用 Reply by Email（站点不提供公开评论）。
# 推荐使用 smtpdm.aliyun.com:465 + 隐式 TLS；如果阿里云控制台给出其他端口，以控制台为准。
DISCOURSE_SMTP_ADDRESS=smtpdm.aliyun.com
DISCOURSE_SMTP_PORT=465
DISCOURSE_SMTP_DOMAIN=veic.tech
DISCOURSE_SMTP_USER_NAME=kervein@veic.tech
DISCOURSE_SMTP_PASSWORD=
DISCOURSE_SMTP_AUTHENTICATION=plain
DISCOURSE_SMTP_ENABLE_START_TLS=false
DISCOURSE_SMTP_FORCE_TLS=true
DISCOURSE_NOTIFICATION_EMAIL=kervein@veic.tech
DISCOURSE_CONTACT_EMAIL=kervein@veic.tech
# 发件人显示名称；部署后同步到 Discourse 的 email_site_title 站点设置。
DISCOURSE_EMAIL_SITE_TITLE=KerveinBlog
# 首次安装时授予管理员/开发者权限的邮箱；应填写你能实际收信的邮箱。
DISCOURSE_DEVELOPER_EMAILS=__CHANGE_ME__
DISCOURSE_REPLY_BY_EMAIL_ENABLED=false
DISCOURSE_ENABLE_SMTP=true

