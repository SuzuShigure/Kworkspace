# ============================================================
# Agent 使用协议
# ============================================================
# 
# 安全使用规则：
# 1. 启动时 source .env 注入环境变量，避免在上下文中明文传密钥
#    Linux/macOS: set -a && source .env && set +a
#    Windows:     Get-Content .env | ForEach-Object { if ($_ -match '^([^#].*?)=(.*)') { [Environment]::SetEnvironmentVariable(***^='^[^#].*?)=(.*)') { \$env:\$k=\$v } }
# 2. 引用时用变量名，永不在输出中打印完整密钥值
#    示例: "使用 \$ECS_USER@\$ECS_HOST" ✓  "密码是 \$ECS_PASSWORD" ✗
# 3. SSH 免密优先，密码只做 fallback
#    示例: ssh -i ~/.ssh/id_ed25519_gitea \$ECS_USER@\$ECS_HOST
# 4. Git remote 用 token 内嵌 URL 或 SSH，不用密码
#    示例: git clone http://\$GITEA_TOKEN@host/repo.git
# 5. API Key 走环境变量，不硬编码到配置文件
#    示例: curl -H "Authorization: Bearer \$ZECOUSA_API_KEY" ...
# 6. .env 文件本身不提交到 Git，.env.template 可以提交
# 7. 遇到新机器部署，优先用 Vaultwarden 拉取而非复制 .env
#
# 快速注入（Linux/macOS/bash）:
#   eval \$(cat .env | grep -v '^#' | grep -v '^\$' | sed 's/^/export /')
#
# 快速注入（PowerShell）:
#   Get-Content .env | Where { \$_ -match '^[^#].*?=(.*)' } | ForEach { \$k,\$v = \$_ -split '=',2; Set-Item \"env:\$k\" \$v }
