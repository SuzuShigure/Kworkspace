{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build current file (GCC/Clang)",
            "type": "shell",
            "command": "c++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/program"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
